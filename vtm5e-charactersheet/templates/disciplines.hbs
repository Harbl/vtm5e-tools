{{!-- VtM5e Character Sheet Reskin - Disciplines: flat list instead of
      wod5e's stock select-then-reveal two-pane layout. Every owned power is
      its own expandable row grouped under its discipline; wod5e already
      auto-reveals a discipline once it has any owned power (see
      prepareDisciplinePowers in the system source), so dragging a power
      from a compendium onto the sheet "just works" with no extra code
      here - the category appears on its own. --}}
<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
    <div class="cs-disc-scroll">
        {{#each disciplines as |discipline discKey|}}
            {{#if discipline.visible}}
                <div class="cs-disc-group">
                    <div class="cs-disc-header">
                        <span class="cs-disc-name" data-tooltip="{{discipline.tooltip}}" data-tooltip-direction="UP">{{discipline.displayName}}</span>
                        {{#if (and (ne discKey "rituals") (ne discKey "ceremonies"))}}
                            <div class="resource-value cs-disc-dots" data-value="{{discipline.value}}" data-name="system.disciplines.{{discKey}}.value">
                                <span class="resource-value-empty" data-action="dotCounterEmpty"></span>
                                {{#numLoop 5}}
                                    <span class="resource-value-step" data-action="dotCounterChange" data-index="{{this}}"></span>
                                {{/numLoop}}
                            </div>
                        {{/if}}
                        <div class="item-controls cs-disc-header-controls">
                            {{#if (and (ne discKey "rituals") (ne discKey "ceremonies"))}}
                                <a class="rollable discipline-dice" data-action="roll" title="{{localize 'WOD5E.RollList.Label'}}" data-value-paths="disciplines.{{discKey}}.value"
                                    data-discipline="{{discKey}}" data-select-dialog="true">
                                    <i class="fa-solid fa-dice-d10"></i>
                                </a>
                            {{/if}}
                            <a class="item-control discipline-chat" data-action="disciplineChat" title="{{localize 'WOD5E.ItemsList.ShowToChat'}}" data-discipline="{{discKey}}">
                                <i class="fas fa-comment-alt"></i>
                            </a>
                            {{#if (eq discipline.powers.length 0)}}
                                <a class="item-control discipline-delete" data-action="removeDiscipline" title="{{localize 'WOD5E.Delete'}}" data-discipline="{{discKey}}">
                                    <i class="fas fa-trash"></i>
                                </a>
                            {{/if}}
                        </div>
                    </div>

                    {{#each discipline.powers as |power|}}
                        <div class="cs-expand-row" data-drag="true" data-item-id="{{power.id}}" data-document-uuid="{{power.uuid}}" data-type="Item">
                            <div class="cs-expand-summary" data-action="toggleExpandRow">
                                {{#if power.system.dicepool}}
                                    {{#if (isNotEmpty power.system.dicepool)}}
                                        <a class="cs-row-icon rollable-item" data-action="rollItem" data-item-uuid="{{power.uuid}}" title="{{localize 'WOD5E.RollList.Label'}}">
                                            <i class="fa-solid fa-dice-d10"></i>
                                        </a>
                                    {{/if}}
                                {{/if}}
                                <span class="cs-power-name">{{power.name}}</span>
                                <span class="cs-power-cost">{{power.costText}}</span>
                                <span class="cs-expand-spacer"></span>
                                <span class="cs-power-level">{{power.system.level}}</span>
                                <a class="cs-row-icon" data-action="itemChat" data-item-id="{{power._id}}" title="{{localize 'WOD5E.ItemsList.ShowToChat'}}">
                                    <i class="fas fa-comment-alt"></i>
                                </a>
                                <a class="cs-row-icon" data-action="itemDelete" data-item-id="{{power._id}}" title="{{localize 'WOD5E.Delete'}}">
                                    <i class="fas fa-trash"></i>
                                </a>
                                <span class="cs-expand-caret"><i class="fas fa-chevron-down"></i></span>
                            </div>
                            <div class="cs-expand-detail">
                                {{{power.system.enrichedDescription}}}
                                {{#ifgr power.system.cost 0}}
                                    <div class="cs-power-rouse">
                                        {{localize 'WOD5E.ItemsList.Cost'}}: {{power.costText}}
                                        <a class="cs-row-icon rollable-item" data-action="roll" data-disable-basic-dice="true" data-use-absolute-value="true"
                                            data-selectors="rouse{{#ifeq discKey 'oblivion'}} oblivion-rouse{{/ifeq}}"
                                            data-absolute-value="{{power.system.cost}}" data-label="{{localize 'WOD5E.VTM.RousingBlood'}} - {{power.name}}"
                                            data-increase-hunger="true" title="{{localize 'WOD5E.VTM.RollRouse'}}" data-item-id="{{power.id}}">
                                            <i class="fa-solid fa-dice-d10"></i>
                                        </a>
                                    </div>
                                {{/ifgr}}
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{/if}}
        {{/each}}
    </div>
</section>
